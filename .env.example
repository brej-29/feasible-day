# Environment configuration for City Travel Microguide Generator

# === Required ===
# Groq API key used for all LLM-powered agents
GROQ_API_KEY="your_groq_api_key_here"

# === Optional (recommended) ===
# OpenTripMap API key for points-of-interest search
OPENTRIPMAP_API_KEY="your_opentripmap_api_key_here"

# Google Places API key for rich place details (text search / nearby search)
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"

# === Application settings ===
# Application environment: "development" or "production"
APP_ENV="development"

# Default model to use with Groq (can be overridden per-agent later)
GROQ_DEFAULT_MODEL="llama3-8b-8192"

# Whether to enable verbose logging (true/false)
APP_DEBUG="false"