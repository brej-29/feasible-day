{
  "name": "feasible-day",
  "version": "0.1.0",
  "description": "Day plans you can actually walk: grounded in OpenStreetMap, checked against opening hours and walking time.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "data": "tsx eval/build-snapshots.ts",
    "eval": "tsx eval/run.ts",
    "calibrate": "tsx eval/calibrate-walk.ts",
    "osrm-check": "tsx eval/osrm-check.ts",
    "ops:smoke": "tsx --env-file-if-exists=.env ops/smoke.ts",
    "update": "tsx --env-file-if-exists=.env ops/update.ts"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "opening_hours": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true
}
